# Скопируйте в .env и при необходимости измените.
# Мастер-ключ НЕ храните в git. При первом запуске ключ создаётся в data/master.key.

APP_HOST=127.0.0.1
APP_PORT=8080
APP_DEBUG=false

# Стартовый администратор. Если ADMIN_PASSWORD пуст, пароль генерируется при первом запуске,
# печатается в консоль и сохраняется в data/initial_credentials.txt. При первом входе его нужно сменить.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Адреса reverse-proxy через запятую. Только от них принимается X-Forwarded-For
# (лимит попыток входа и журнал видят реальный адрес клиента). Пусто - заголовок игнорируется.
TRUSTED_PROXIES=

# Слушать сеть только вместе с TLS-прокси перед приложением.
ALLOW_REMOTE=false

# tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# float32 по умолчанию: int8 и int8_float32 на части CPU портят текст (см. docs/PERFORMANCE.md)
WHISPER_COMPUTE_TYPE=float32
# Луч 1–5. Пакет 4–8 ускоряет записи от 90 секунд на CPU.
WHISPER_BEAM_SIZE=5
WHISPER_BATCH_SIZE=8
WHISPER_CPU_THREADS=0

# Одновременно обрабатывается только N звонков, остальные ждут в очереди
MAX_PARALLEL_JOBS=1

# Максимальный размер файла, МБ
MAX_UPLOAD_MB=80

# Жёсткий лимит длительности (секунды). Норматив кейса: 10 мин за 3–5 мин обработки.
MAX_DURATION_SEC=900

# Озвучка демо-звонков (Silero, нужен requirements-voice.txt). По умолчанию выключена, без неё ничего не скачивается.
DEMO_VOICE_ENABLED=false

# Стерео: роли по каналам (auto | left | right - канал оператора)
STEREO_DIARIZATION=true
STEREO_OPERATOR_CHANNEL=auto

# Необязательная оценка локальной LLM через Ollama (none | ollama). При ошибке - только правила.
LLM_PROVIDER=none
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://127.0.0.1:11434
LLM_WEIGHT=0.5
LLM_TIMEOUT_SEC=120

# База данных. Пусто - SQLite в data/app.db. PostgreSQL:
# DATABASE_URL=postgresql+psycopg://rechkontrol:ПАРОЛЬ@127.0.0.1:5432/rechkontrol
DATABASE_URL=
# Пароль PostgreSQL для docker compose (только буквы и цифры)
POSTGRES_PASSWORD=
